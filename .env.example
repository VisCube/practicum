# Общее
APP_ENV=dev
DEBUG_UI=true
LOG_LEVEL=INFO
DATA_DIR=data
PORT=8000

# Адаптеры:
#   DIALOG_ADAPTER: rules | cloudru
#   ASR_ADAPTER:    fake | vosk | t-one | cloudru
#   TTS_ADAPTER:    fake | piper | silero
#   LLM_ADAPTER:    fake | openai | cloudru   (для DIALOG_ADAPTER=rules)
#   CRM_ADAPTER:    fake | telegram | bitrix
DIALOG_ADAPTER=rules
ASR_ADAPTER=fake
TTS_ADAPTER=fake
LLM_ADAPTER=fake
CRM_ADAPTER=fake

# Таймауты (сек)
CRM_TIMEOUT=2.0
LLM_TIMEOUT=8.0
SPEECH_TIMEOUT=10.0
AGENT_TIMEOUT=45.0

# OpenAI-совместимый LLM (для LLM_ADAPTER=openai)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Cloud.ru: Foundation Models, STT, Managed RAG и IAM
# (для DIALOG_ADAPTER=cloudru, ASR_ADAPTER=cloudru, LLM_ADAPTER=cloudru)
FM_API_KEY=
FM_BASE_URL=https://foundation-models.api.cloud.ru/v1
STT_MODEL=openai/whisper-large-v3

RAG_KEY_ID=
RAG_KEY_SECRET=
RAG_BASE_URL=
IAM_TOKEN_URL=https://iam.api.cloud.ru/api/v1/auth/token

# Локальные модели речи и классификатора (опционально)
# ASR_SAMPLE_RATE=16000
# ASR_ITN=true
# VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22
# TONE_MODEL_DIR=models/t-one
# TONE_NUM_THREADS=2
# PIPER_MODEL_PATH=models/ru_RU-ruslan-medium.onnx
# SILERO_MODEL_PATH=models/v5_cis_base.pt
# SILERO_SPEAKER=
# SILERO_RATE=medium
# SILERO_PITCH=medium
# CLASSIFIER_MODEL_PATH=models/model.pkl

# Telegram (CRM_ADAPTER=telegram): заявки летят в чат диспетчера
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_CHANNEL_USERNAME=   # опционально: публичный канал для ссылки на заявку
